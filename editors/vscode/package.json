{
  "name": "sumo-lint",
  "displayName": "SUMO wiki markup linter",
  "description": "Lints SUMO Knowledge Base wiki markup via the sumo-lint-lsp language server.",
  "version": "0.3.0",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thunderbird/sumo-linter"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:sumo-wiki"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node test/grammar.test.mjs && node test/link.test.mjs"
  },
  "contributes": {
    "languages": [
      {
        "id": "sumo-wiki",
        "aliases": [
          "SUMO wiki markup"
        ],
        "extensions": [
          ".sumo",
          ".wiki"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sumo-wiki",
        "scopeName": "text.sumo-wiki",
        "path": "./syntaxes/sumo-wiki.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sumoLint.insertLink",
        "title": "Insert Link",
        "category": "SUMO"
      }
    ],
    "keybindings": [
      {
        "command": "sumoLint.insertLink",
        "key": "ctrl+k ctrl+l",
        "mac": "cmd+k cmd+l",
        "when": "editorTextFocus && !editorReadonly && editorLangId == sumo-wiki"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sumoLint.insertLink",
          "when": "editorLangId == sumo-wiki"
        }
      ],
      "editor/context": [
        {
          "command": "sumoLint.insertLink",
          "when": "editorLangId == sumo-wiki",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "sumo-lint",
      "properties": {
        "sumoLint.serverPath": {
          "type": "string",
          "default": "sumo-lint-lsp",
          "description": "Path to the sumo-lint-lsp binary. Use an absolute path if it is not on PATH."
        },
        "sumoLint.pasteUrlAsLink": {
          "type": "boolean",
          "default": true,
          "description": "Pasting a URL over selected text writes [url text] instead of replacing the selection. Plain paste is unaffected."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
