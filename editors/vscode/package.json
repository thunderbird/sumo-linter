{
  "name": "sumo-lint",
  "displayName": "SUMO wiki markup linter",
  "description": "Lints SUMO Knowledge Base wiki markup via the sumo-lint-lsp language server.",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "repository": { "type": "git", "url": "https://github.com/thunderbird/sumo-linter" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Linters"],
  "activationEvents": ["onLanguage:sumo-wiki"],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sumo-wiki",
        "aliases": ["SUMO wiki markup"],
        "extensions": [".sumo", ".wiki"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "sumo-lint",
      "properties": {
        "sumoLint.serverPath": {
          "type": "string",
          "default": "sumo-lint-lsp",
          "description": "Path to the sumo-lint-lsp binary. Use an absolute path if it is not on PATH."
        }
      }
    }
  },
  "dependencies": { "vscode-languageclient": "^9.0.1" }
}
